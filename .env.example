# Telegram
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_BOT_TOKEN=123456789:telegram_bot_token_here
OWNER_ID=123456789
# Optional: comma-separated user or group/chat IDs allowed to use the bot.
# /purge, /logs, /auth and /unauth stay owner-only.
# AUTHORIZED_CHAT_IDS=-1001234567890,987654321

# TorBox
TORBOX_API_KEY=your_torbox_api_key

# Optional: seconds one TorBox or NZBHydra request may take. Defaults to 30.
# HTTP_TIMEOUT=30

# Optional: SQLite file storing IDs authorized at runtime with /auth and the
# channel post queue. Defaults to ./torbot.db.
# DATABASE_PATH=torbot.db

# Optional: channel finished downloads are posted to. The bot must be an admin
# there with Post Messages. Needs the Worker proxy below.
# DOWNLOAD_CHANNEL_ID=-1001234567890

# --- Cloudflare Worker proxy (hide TorBox links), see workers/torbox-proxy ---
# PROXY_SECRET must be 16+ characters and match the Worker's secret.
# PROXY_BASE_URL=https://torbot-dl.YOUR_SUBDOMAIN.workers.dev
# PROXY_SECRET=long_random_string_same_as_worker
# How long a file-page link (channel posts) stays valid. Defaults to 7 days.
# PROXY_PAGE_TTL_SECONDS=604800

# --- NZB search via NZBHydra2 (/nzbsearch, /nzb with NZB IDs) ---
# Hydra login goes in the URL as basic auth; a trailing /api is accepted.
# NZBHYDRA_URL=https://user:password@hydra.example.com
# Downloader name exactly as configured in Hydra (Config -> Downloaders).
# NZBHYDRA_DOWNLOADER_NAME=TorBox
# NZBSEARCH_RESULTS_PER_PAGE=5
# Seconds before search results are redacted automatically. 0 keeps them until CLOSE.
# NZBSEARCH_AUTOREDACT=0
